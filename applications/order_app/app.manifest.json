{
  "manifestVersion": "1.0",
  "id": "uli.examples.order",
  "name": "Order App",
  "description": "Standalone order form + order list. Consumes the inventory.check capability from another application through the ULI broker.",
  "version": "1.0.0",
  "dataOwner": "uli.examples.order",
  "uli": {
    "protocol": ">=1.0.0 <2.0.0"
  },
  "runtime": {
    "type": "local-python",
    "entry": "backend/app.py",
    "port": 0,
    "healthPath": "/health"
  },
  "frontend": {
    "entry": "frontend/index.html",
    "embed": true
  },
  "capabilities": {
    "provides": [
      {
        "id": "order.create",
        "version": "1.0.0",
        "description": "Create an order and validate stock through inventory.check.",
        "inputType": "uli.order.create.request@1",
        "outputType": "uli.order.create.response@1",
        "timeoutMs": 15000,
        "inputSchema": {
          "type": "object",
          "required": ["customer", "items"],
          "additionalProperties": false,
          "properties": {
            "customer": { "type": "string", "minLength": 1 },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["sku", "quantity"],
                "additionalProperties": false,
                "properties": {
                  "sku": { "type": "string", "minLength": 1 },
                  "quantity": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "required": ["orderId", "status", "customer", "lines"],
          "properties": {
            "orderId": { "type": "string" },
            "status": { "type": "string", "enum": ["confirmed", "backorder"] },
            "customer": { "type": "string" },
            "createdAt": { "type": "string" },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sku", "quantity", "available", "inStock"],
                "properties": {
                  "sku": { "type": "string" },
                  "quantity": { "type": "integer" },
                  "available": { "type": "integer" },
                  "inStock": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      {
        "id": "order.list",
        "version": "1.0.0",
        "description": "List orders created by this application.",
        "inputType": "uli.order.list.request@1",
        "outputType": "uli.order.list.response@1",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "required": ["orders"],
          "properties": {
            "orders": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    ],
    "requires": [
      {
        "id": "inventory.check",
        "version": "^1.0.0",
        "optional": false
      }
    ]
  },
  "events": {
    "publishes": [
      {
        "name": "order.created",
        "version": "1.0.0",
        "description": "Emitted after an order is accepted.",
        "schema": {
          "type": "object",
          "required": ["orderId", "customer", "status"],
          "properties": {
            "orderId": { "type": "string" },
            "customer": { "type": "string" },
            "status": { "type": "string" },
            "lineCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    ],
    "subscribes": []
  },
  "permissions": [
    "data.own",
    "storage.kv",
    "capability.invoke.inventory.check",
    "events.publish.order.created"
  ],
  "ui": {
    "extensionPoints": [
      {
        "id": "order.dashboard",
        "slot": "app.detail.tab",
        "title": "Orders",
        "description": "Order list for the order app."
      }
    ]
  },
  "config": {
    "fields": [
      {
        "key": "default_customer",
        "label": "Default customer name",
        "type": "string",
        "required": false,
        "default": "Walk-in",
        "description": "Pre-filled in the order form."
      }
    ]
  }
}
